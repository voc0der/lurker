//- Inline SVG icons for the reddit-style mobile layout. Every icon draws in
//- currentColor and gets its size from CSS.
mixin icon(name)
  case name
    when "menu"
      svg.icon(viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false")
        path(d="M2.75 4h14.5M2.75 10h14.5M2.75 16h14.5")
    when "search"
      svg.icon(viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false")
        circle(cx="9.8" cy="9.2" r="7.4")
        path(d="m15.05 14.45 3.7 3.75")
    when "overflow"
      svg.icon(viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false")
        circle(cx="4" cy="10" r="1.75")
        circle(cx="10" cy="10" r="1.75")
        circle(cx="16" cy="10" r="1.75")
    when "overflow-sm"
      svg.icon(viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false")
        circle(cx="3.35" cy="8" r="1.45")
        circle(cx="8" cy="8" r="1.45")
        circle(cx="12.65" cy="8" r="1.45")
    when "upvote"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="M8 .8 1.55 7.25H5.5V12a2.5 2.5 0 0 0 5 0V7.25h3.95Z")
    when "downvote"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="M8 15.2 1.55 8.75H5.5V4a2.5 2.5 0 0 1 5 0v4.75h3.95Z")
    when "comment"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="M8.4 1.45a6.6 6.6 0 1 1 0 13.2H1.2l1.85-2.8A6.6 6.6 0 0 1 8.4 1.45Z")
    when "share"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="M9.6 2.5 15 7.65l-5.4 5.15V9.9C6 9.9 3 11.1 1 14c0-5.3 3.6-8.9 8.6-9.1Z")
    when "external"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="M6.5 2.5h-3a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-3M9.5 2.5h4v4M13.5 2.5l-6 6")
    when "plus-circle"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true" focusable="false")
        circle(cx="8" cy="8" r="6.85")
        path(d="M8 4.75v6.5M4.75 8h6.5")
    when "minus-circle"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true" focusable="false")
        circle(cx="8" cy="8" r="6.85")
        path(d="M4.75 8h6.5")
    when "chevron-down"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="M4.25 6.25 8 10l3.75-3.75")
    when "pin"
      svg.icon(viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false")
        path(d="m9.9 1.4 4.7 4.7-1.2 1.2-.9-.3-2.4 2.4.4 2.6-1.2 1.2-2.6-2.6-3.7 3.7-1-1 3.7-3.7-2.6-2.6 1.2-1.2 2.6.4 2.4-2.4-.3-.9Z")
    when "app"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="M8 1.6 13.6 4.8v6.4L8 14.4l-5.6-3.2V4.8ZM2.4 4.8 8 8l5.6-3.2M8 8v6.4")
    when "home"
      svg.icon(viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="M3.5 8.25 10 3l6.5 5.25v8.25a.5.5 0 0 1-.5.5h-4v-5h-4v5H4a.5.5 0 0 1-.5-.5Z")
    when "popular"
      svg.icon(viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
        circle(cx="10" cy="10" r="7.75")
        path(d="m5.75 12.75 3.5-3.5 2 2 3.25-3.25M11.25 8h3.25v3.25")
    when "all"
      svg.icon(viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false")
        circle(cx="10" cy="10" r="7.75")
        path(d="M7 13.25v-2.5M10 13.25v-6.5M13 13.25v-4.5")
    when "communities"
      svg.icon(viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false")
        circle(cx="7.5" cy="7" r="3")
        path(d="M2 16.5c0-3 2.4-5 5.5-5s5.5 2 5.5 5")
        circle(cx="14" cy="7.5" r="2.5")
        path(d="M13.75 11.5c2.6 0 4.25 1.8 4.25 4.75")
    when "user"
      svg.icon(viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false")
        circle(cx="10" cy="6.75" r="3.5")
        path(d="M3.5 17.25c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6")
    when "logout"
      svg.icon(viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="M8 3.5H4.5a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1H8M12.5 6.5 16 10l-3.5 3.5M16 10H7.5")
    when "close"
      svg.icon(viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false")
        path(d="m5 5 10 10M15 5 5 15")
    when "view-card"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true" focusable="false")
        rect(x="2.5" y="2.5" width="11" height="11" rx="2")
        path(d="M2.5 10h11")
    when "view-compact"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true" focusable="false")
        path(d="M2.5 3.5h11M2.5 8h11M2.5 12.5h11")
    when "check"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="m3.5 8.5 3 3 6-7")
    when "link"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true" focusable="false")
        path(d="M6.75 9.25a3 3 0 0 0 4.24 0l2.12-2.12a3 3 0 0 0-4.24-4.24l-.7.7M9.25 6.75a3 3 0 0 0-4.24 0L2.89 8.87a3 3 0 0 0 4.24 4.24l.7-.7")
    when "arrow-down"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="M8 2.5v11M3.5 9 8 13.5 12.5 9")
    when "arrow-up"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="M8 13.5v-11M3.5 7 8 2.5 12.5 7")
    when "undelete"
      svg.icon(viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
        path(d="M2.5 7.5a5.5 5.5 0 1 1 1.6 3.9M2.5 12V7.5H7")
