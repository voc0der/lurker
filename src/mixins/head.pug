mixin head(title)
  head
    meta(name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover")
    meta(charset='UTF-8')
    if csrfToken
      meta(name="csrf-token" content=csrfToken)
    title #{`${title} · lurker `}

    //- PWA Support
    link(rel="manifest" href="/manifest.json")
    meta(name="theme-color" content="#0b1416")
    meta(name="color-scheme" content="light dark")
    meta(name="mobile-web-app-capable" content="yes")
    meta(name="application-name" content="Lurker")

    //- Apple iOS PWA Support
    meta(name="apple-mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-status-bar-style" content="black-translucent")
    meta(name="apple-mobile-web-app-title" content="Lurker")
    link(rel="apple-touch-icon" href="/icon-180.png")
    link(rel="apple-touch-icon" sizes="152x152" href="/icon-152.png")
    link(rel="apple-touch-icon" sizes="180x180" href="/icon-180.png")

    //- Service Worker Registration
    script.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/service-worker.js')
            .then((registration) => {
              console.log('Service Worker registered:', registration.scope);
            })
            .catch((error) => {
              console.error('Service Worker registration failed:', error);
            });
        });
      }

    //- Styles
    link(rel="stylesheet", href="/styles.css")
    if theme
      link(rel="stylesheet", href=`/${theme}.css`)
    link(rel="preconnect" href="https://rsms.me/")
    link(rel="stylesheet" href="https://rsms.me/inter/inter.css")
    script(src="/vendor/dash.all.min.js" defer)
    script.
      //- Reddit serves hosted-video audio separately from the fallback
      //- MP4. Prepare HLS/DASH before playback so Android does not swap
      //- sources while entering its native fullscreen player. If mobile
      //- playback starts without that preparation, keep the known-good
      //- MP4 instead. DASH errors also fall back to the MP4.
      function isMobileVideoContext() {
        return window.matchMedia('(pointer: coarse)').matches
          || window.matchMedia('(max-width: 767px)').matches;
      }

      function initVideoPlayer(video, resume, prepareMobileDash) {
        if (!video || video.dataset.playerInitialized) return;
        var hlsUrl = video.dataset.hlsUrl;
        var dashUrl = video.dataset.dashUrl;
        var fallbackUrl = video.dataset.fallbackUrl;
        var mobileContext = isMobileVideoContext();
        if (hlsUrl && video.canPlayType('application/vnd.apple.mpegurl')) {
          video.dataset.playerInitialized = "1";
          video.src = hlsUrl;
          video.load();
          if (resume) {
            var playPromise = video.play();
            if (playPromise) playPromise.catch(function () {});
          }
        } else if (dashUrl && window.dashjs && (!mobileContext || prepareMobileDash || !fallbackUrl)) {
          video.dataset.playerInitialized = "1";
          var player = dashjs.MediaPlayer().create();
          var fallbackActivated = false;
          var activateFallback = function () {
            if (!fallbackUrl || fallbackActivated) return;
            fallbackActivated = true;
            var shouldResume = resume || !video.paused;
            if (player.destroy) player.destroy();
            video.dataset.playerInitialized = "fallback";
            video.src = fallbackUrl;
            video.load();
            if (shouldResume) {
              var fallbackPlay = video.play();
              if (fallbackPlay) fallbackPlay.catch(function () {});
            }
          };
          if (fallbackUrl && dashjs.MediaPlayer.events && dashjs.MediaPlayer.events.ERROR) {
            player.on(dashjs.MediaPlayer.events.ERROR, function () {
              if (fallbackActivated) return;
              activateFallback();
            });
          }
          try {
            player.initialize(video, dashUrl, !!resume);
          } catch (_error) {
            activateFallback();
          }
        } else if (mobileContext && fallbackUrl && (!prepareMobileDash || !dashUrl)) {
          //- This path intentionally does not change video.src.
          video.dataset.playerInitialized = "1";
        }
      }
